<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <LocalDebuggerCommand Condition="'$(Configuration)|$(Platform)'=='RelWithDebInfo|x64'">$(OSG_BUILD)\bin\osgviewer.exe</LocalDebuggerCommand>
    <LocalDebuggerCommand Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">$(OSG_BUILD)\bin\osgviewer.exe</LocalDebuggerCommand>
    <LocalDebuggerWorkingDirectory>$(TargetDir)</LocalDebuggerWorkingDirectory>
    <LocalDebuggerEnvironment>OSG_NOTIFY_LEVEL=NOTICE</LocalDebuggerEnvironment>
    <LocalDebuggerCommandArguments>--image dog_left_eye.jpg.lb.qcrop</LocalDebuggerCommandArguments>

  </PropertyGroup>
</Project>